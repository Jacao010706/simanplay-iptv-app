<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0A0A0FFF" />

    <!-- Cabeçalho -->
    <Rectangle id="header" width="1920" height="130" color="0x1A1625FF">
      <Label id="appTitle" translation="[90,38]" width="900" height="60"
             font="font:LargeBoldSystemFont" color="0xE94BFFFF" />
      <Label id="breadcrumb" translation="[900,48]" width="930" height="40" horizAlign="right"
             font="font:SmallSystemFont" color="0xCCCCCCFF" />
    </Rectangle>

    <!-- Lista única reaproveitada: menu, categorias, itens, temporadas, episódios -->
    <LabelList id="list" translation="[90,170]" itemSize="[1740,72]" numRows="11"
               focusBitmapBlendColor="0xE94BFFFF" color="0xFFFFFFFF" focusedColor="0x000000FF"
               font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" vertFocusAnimationStyle="floatingFocus" />

    <!-- Painel do aparelho (MAC + chave + QR) e da assinatura vencida -->
    <Group id="devPanel" translation="[90,170]" visible="false">
      <Rectangle id="devBox" width="740" height="800" color="0x1A1625FF" />
      <Label id="devL1" translation="[40,30]" width="660" height="36" font="font:SmallSystemFont" color="0x999999FF" />
      <Label id="devMac" translation="[40,66]" width="660" height="70" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
      <Label id="devL2" translation="[40,150]" width="660" height="36" font="font:SmallSystemFont" color="0x999999FF" />
      <Label id="devKey" translation="[40,186]" width="660" height="70" font="font:LargeBoldSystemFont" color="0xE94BFFFF" />
      <Label id="devHelp" translation="[40,270]" width="660" height="225" wrap="true" font="font:SmallSystemFont" color="0xDDDDDDFF" />
      <Poster id="devQr" translation="[40,505]" width="270" height="270" />
      <Label id="devFoot" translation="[340,505]" width="370" height="280" wrap="true" font="font:SmallSystemFont" color="0xFFD54FFF" />
    </Group>

    <!-- Início em grade: blocos criados no MainScene.brs (buildHomeGrid) -->
    <Group id="homeGrid" visible="false">
      <Rectangle id="homeOutBox" translation="[745,690]" width="430" height="80" color="0x2A2538FF">
        <Label id="homeOut" translation="[0,20]" width="430" height="40" horizAlign="center"
               font="font:MediumSystemFont" color="0xCCCCCCFF" text="Trocar lista / Sair" />
      </Rectangle>
      <Label id="homeHint" translation="[0,810]" width="1920" height="40" horizAlign="center"
             font="font:SmallSystemFont" color="0x777777FF" text="Use as setas e aperte OK" />
    </Group>

    <Label id="status" translation="[90,1000]" width="1740" height="50"
           font="font:SmallSystemFont" color="0xCCCCCCFF" />

    <Timer id="pollTimer" duration="20" repeat="true" />
    <Video id="video" width="1920" height="1080" visible="false" />
  </children>
  <script type="text/brightscript" uri="pkg:/components/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/Config.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
